{
  "name": "vitrin-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Vitrin — iOS App Store Connect metadata, screenshot, creative and App Preview automation",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -b packages/cli",
    "clean": "tsc -b --clean packages/cli",
    "typecheck": "tsc -b packages/cli packages/video",
    "test": "vitest run",
    "vitrin": "node packages/cli/dist/bin.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  }
}
