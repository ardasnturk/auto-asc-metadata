{
  "name": "vitrin-monorepo",
  "private": true,
  "version": "0.6.0",
  "description": "Vitrin — automate App Store Connect metadata, screenshots, creatives and App Previews for iOS apps",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b packages/cli",
    "clean": "tsc -b --clean packages/cli",
    "typecheck": "tsc -b packages/cli packages/video",
    "test": "vitest run",
    "vitrin": "node packages/cli/dist/bin.js",
    "pack:release": "pnpm build && node scripts/pack.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.1",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "author": "Arda Sentürk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ardasnturk/vitrin.git"
  },
  "homepage": "https://github.com/ardasnturk/vitrin#readme",
  "bugs": {
    "url": "https://github.com/ardasnturk/vitrin/issues"
  }
}
