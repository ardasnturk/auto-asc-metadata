# Generated by Vitrin. `vitrin upload` calls these lanes; they can also be run by hand.
# vitrin-template: 2
# Values are read from .env and never logged.
#
# App Store (deliver), one run per App Store platform:
#   bundle exec fastlane ios vitrin_upload platform:ios        # iPhone, iPad, Duo and Apple Watch screenshots
#   bundle exec fastlane ios vitrin_upload platform:osx        # Mac
#   bundle exec fastlane ios vitrin_upload platform:appletvos  # Apple TV
#   bundle exec fastlane ios vitrin_upload platform:xros       # Apple Vision Pro
# Google Play (supply), listing text, release notes and images only (never a binary, a track change or a rollout):
#   bundle exec fastlane android vitrin_play_upload [validate_only:true]
#
# Overwrite semantics (fastlane 2.241.1): overwrite_screenshots deletes EVERY screenshot set of each locale that has
# files in screenshots_path, and overwrite_preview_videos every preview set of that locale. `vitrin upload` therefore
# fills the per-platform folders with complete sets only and replaces partial sets through the App Asset Library.
# supply replaces only the image types that have files, and the release notes of the version code for all languages.
require "base64"

default_platform(:ios)

platform :ios do
  private_lane :vitrin_api_key do
    if ENV["ASC_KEY_CONTENT_BASE64"].to_s.strip != ""
      app_store_connect_api_key(
        key_id: ENV.fetch("ASC_KEY_ID"),
        issuer_id: ENV.fetch("ASC_ISSUER_ID"),
        key_content: ENV.fetch("ASC_KEY_CONTENT_BASE64"),
        is_key_content_base64: true,
        duration: 1200,
        in_house: false
      )
    else
      app_store_connect_api_key(
        key_id: ENV.fetch("ASC_KEY_ID"),
        issuer_id: ENV.fetch("ASC_ISSUER_ID"),
        key_filepath: ENV.fetch("ASC_KEY_PATH"),
        duration: 1200,
        in_house: false
      )
    end
  end

  # deliver accepts ios, osx, appletvos (tvos) and xros (visionOS). watchOS screenshots belong to the iOS version.
  def vitrin_platform(options)
    value = (options && options[:platform]).to_s.strip
    value = ENV.fetch("VITRIN_PLATFORM", "ios") if value.empty?
    value = { "macos" => "osx", "tvos" => "appletvos", "visionos" => "xros", "watchos" => "ios" }.fetch(value, value)
    UI.user_error!("Unsupported platform #{value}; use ios, osx, appletvos or xros") unless %w(ios osx appletvos xros).include?(value)
    value
  end

  def vitrin_path(env_name, default)
    value = ENV[env_name].to_s.strip
    value.empty? ? default : value
  end

  def vitrin_common(options = {})
    metadata_path = vitrin_path("VITRIN_METADATA_PATH", "fastlane/metadata")
    {
      app_identifier: ENV.fetch("VITRIN_BUNDLE_ID"),
      platform: vitrin_platform(options),
      # Per-platform copies built by `vitrin upload` (.vitrin/deliver/<platform>/): each deliver run only sees
      # its own screenshot sizes, and fastlane/metadata/android (supply) is left out.
      metadata_path: metadata_path,
      screenshots_path: vitrin_path("VITRIN_SCREENSHOTS_PATH", "fastlane/screenshots"),
      app_previews_path: vitrin_path("VITRIN_PREVIEWS_PATH", "fastlane/app-previews"),
      skip_binary_upload: true,
      submit_for_review: false,
      force: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    }.tap do |opts|
      version = ENV["VITRIN_APP_VERSION"].to_s.strip
      opts[:app_version] = version unless version.empty?
      langs = ENV["VITRIN_LANGUAGES"].to_s.strip
      opts[:languages] = langs.split(",") unless langs.empty?
      # The demo account is never written to a file; it is read from .env only.
      # When this hash is given, deliver ignores the review_information/ folder, so both are merged here.
      if ENV["REVIEW_DEMO_USER"].to_s.strip != ""
        dir = File.expand_path(File.join(metadata_path, "review_information"), File.join(Dir.pwd, ".."))
        dir = File.expand_path(File.join(metadata_path, "review_information")) unless File.directory?(dir)
        read = ->(name) { f = File.join(dir, "#{name}.txt"); File.exist?(f) ? File.read(f).strip : nil }
        opts[:app_review_information] = {
          first_name: read.call("first_name"),
          last_name: read.call("last_name"),
          phone_number: read.call("phone_number"),
          email_address: read.call("email_address"),
          notes: read.call("notes"),
          demo_user: ENV["REVIEW_DEMO_USER"],
          demo_password: ENV["REVIEW_DEMO_PASSWORD"].to_s
        }.compact
      end
    end
  end

  desc "Uploads text metadata, screenshots and App Previews for one platform (does not submit for review)"
  lane :vitrin_upload do |options|
    api_key = vitrin_api_key
    deliver(vitrin_common(options).merge(
      api_key: api_key,
      # Version name and release settings are not Vitrin's job; keep deliver away from them.
      skip_app_version_update: true,
      overwrite_screenshots: true,
      overwrite_preview_videos: true,
      skip_screenshots: ENV["VITRIN_SKIP_SCREENSHOTS"] == "1",
      skip_metadata: ENV["VITRIN_SKIP_METADATA"] == "1"
    ))
  end

  desc "Text metadata only"
  lane :vitrin_upload_metadata do |options|
    api_key = vitrin_api_key
    deliver(vitrin_common(options).merge(api_key: api_key, skip_screenshots: true, skip_app_version_update: true))
  end

  desc "Verify only: check with deliver without uploading"
  lane :vitrin_verify do |options|
    api_key = vitrin_api_key
    deliver(vitrin_common(options).merge(api_key: api_key, verify_only: true, skip_screenshots: true))
  end

  desc "Tries to create an editable App Store version (the first version may have to be created manually in ASC)"
  lane :vitrin_create_version do |options|
    api_key = vitrin_api_key
    deliver(vitrin_common(options).merge(
      api_key: api_key,
      app_version: ENV.fetch("VITRIN_APP_VERSION"),
      skip_screenshots: true,
      skip_metadata: true,
      skip_app_version_update: false
    ))
  end

  desc "Submits for review — only called by `vitrin submit` after explicit confirmation"
  lane :vitrin_submit do |options|
    api_key = vitrin_api_key
    deliver(vitrin_common(options).merge(
      api_key: api_key,
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: true,
      submission_information: { add_id_info_uses_idfa: false }
    ))
  end
end

platform :android do
  # Service account key: GOOGLE_PLAY_JSON_KEY_BASE64 (CI) or a file path. supply masks json_key_data in its summary.
  def vitrin_play_key
    b64 = ENV["GOOGLE_PLAY_JSON_KEY_BASE64"].to_s.strip
    return { json_key_data: Base64.decode64(b64) } unless b64.empty?
    path = ENV["VITRIN_PLAY_JSON_KEY_PATH"].to_s.strip
    path = ENV.fetch("GOOGLE_PLAY_JSON_KEY_PATH") if path.empty?
    { json_key: path }
  end

  desc "Uploads the Google Play listing (text, release notes, screenshots, feature graphic, icon). Never uploads a binary, changes a track or rolls out."
  lane :vitrin_play_upload do |options|
    version_code = ENV["VITRIN_PLAY_VERSION_CODE"].to_s.strip
    validate_only = options[:validate_only].to_s == "true" || ENV["VITRIN_PLAY_VALIDATE_ONLY"] == "1"
    upload_to_play_store(vitrin_play_key.merge(
      package_name: ENV.fetch("VITRIN_PLAY_PACKAGE_NAME"),
      metadata_path: ENV.fetch("VITRIN_PLAY_METADATA_PATH", "fastlane/metadata/android"),
      # supply reads the release on this track to attach release notes; the track itself is not modified.
      track: ENV.fetch("VITRIN_PLAY_TRACK", "production"),
      version_code: version_code.empty? ? nil : version_code.to_i,
      skip_upload_apk: true,
      skip_upload_aab: true,
      # supply replaces the release notes of the version code for every language at once.
      skip_upload_changelogs: version_code.empty? || ENV["VITRIN_PLAY_SKIP_CHANGELOGS"] == "1",
      skip_upload_metadata: ENV["VITRIN_PLAY_SKIP_METADATA"] == "1",
      skip_upload_images: ENV["VITRIN_PLAY_SKIP_IMAGES"] == "1",
      skip_upload_screenshots: ENV["VITRIN_PLAY_SKIP_SCREENSHOTS"] == "1",
      sync_image_upload: true,
      validate_only: validate_only
    ).compact)
  end
end
