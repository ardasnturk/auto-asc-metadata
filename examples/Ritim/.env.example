# Vitrin environment variables. Copy this file to .env and fill it in.
# Never commit .env or *.p8 files; do not paste these values into a chat.

# --- App Store Connect API (required for upload) ---
# App Store Connect > Users and Access > Integrations > App Store Connect API > Team Keys. The role must be at least “App Manager”; use the “Key ID” column in the list.
ASC_KEY_ID=
# The “Issuer ID” (UUID) at the top of the same page.
ASC_ISSUER_ID=
# Path to the AuthKey_<KEYID>.p8 file, which can be downloaded only once when the key is created. Keep it outside the repo or in the git-ignored secrets/ folder. Alternative: ASC_KEY_CONTENT_BASE64.
ASC_KEY_PATH=./secrets/AuthKey_XXXXXXXXXX.p8
# For CI: the output of `base64 -i AuthKey_XXXX.p8`. Not needed when ASC_KEY_PATH is set.
ASC_KEY_CONTENT_BASE64=

# --- App ---
# If left empty, it is read from the Xcode project (PRODUCT_BUNDLE_IDENTIFIER).
APP_BUNDLE_ID=

# --- Optional: Apple Ads (keyword popularity) ---
# Apple Ads > Account Settings > API. Used for keyword popularity; without it, popularity is marked as “estimated”.
APPLE_ADS_CLIENT_ID=
# The Team ID from the Apple Ads API settings.
APPLE_ADS_TEAM_ID=
# The Key ID from the Apple Ads API settings.
APPLE_ADS_KEY_ID=
# Path to the EC private key (.pem) you created for the Apple Ads API.
APPLE_ADS_PRIVATE_KEY_PATH=
# The Organization ID (orgId) of your Apple Ads account.
APPLE_ADS_ORG_ID=

# --- Optional: AppTweak ---
# AppTweak > Account > API. Optional popularity source.
APPTWEAK_API_KEY=

# --- Optional: only for creating the app record (fastlane produce) ---
# Apple ID email, only for creating the app record with `fastlane produce`. Not needed in the normal flow.
FASTLANE_USER=
# Only for `produce`. Your Apple ID password, not an app-specific password (requires 2FA).
FASTLANE_PASSWORD=

# --- Optional: App Review demo account ---
# Demo account username for App Review (for apps that require sign-in).
REVIEW_DEMO_USER=
# Password of the App Review demo account. It must not expire.
REVIEW_DEMO_PASSWORD=
