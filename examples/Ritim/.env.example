# Vitrin ortam değişkenleri. Bu dosyayı .env olarak kopyalayıp doldur.
# .env ve *.p8 dosyaları asla commit edilmez; değerleri sohbete yapıştırma.

# --- App Store Connect API (yükleme için zorunlu) ---
# App Store Connect > Users and Access > Integrations > App Store Connect API > Team Keys. Rol en az “App Manager” olmalı; listedeki “Key ID” sütunu.
ASC_KEY_ID=
# Aynı sayfanın üstündeki “Issuer ID” (UUID).
ASC_ISSUER_ID=
# Anahtarı oluştururken bir kez indirilebilen AuthKey_<KEYID>.p8 dosyasının yolu. Repo dışında ya da .gitignore’daki secrets/ klasöründe tut. Alternatif: ASC_KEY_CONTENT_BASE64.
ASC_KEY_PATH=./secrets/AuthKey_XXXXXXXXXX.p8
# CI için: `base64 -i AuthKey_XXXX.p8` çıktısı. ASC_KEY_PATH doluysa gerekmez.
ASC_KEY_CONTENT_BASE64=

# --- Uygulama ---
# Boş bırakılırsa Xcode projesinden (PRODUCT_BUNDLE_IDENTIFIER) okunur.
APP_BUNDLE_ID=

# --- Opsiyonel: Apple Ads (anahtar kelime popülerliği) ---
# Apple Ads > Account Settings > API. Anahtar kelime popülerliği için; yoksa popülerlik “tahmin” olarak işaretlenir.
APPLE_ADS_CLIENT_ID=
# Apple Ads API ayarlarındaki Team ID.
APPLE_ADS_TEAM_ID=
# Apple Ads API ayarlarındaki Key ID.
APPLE_ADS_KEY_ID=
# Apple Ads API için oluşturduğun EC özel anahtarın (.pem) yolu.
APPLE_ADS_PRIVATE_KEY_PATH=
# Apple Ads hesabındaki Organization ID (orgId).
APPLE_ADS_ORG_ID=

# --- Opsiyonel: AppTweak ---
# AppTweak > Account > API. Opsiyonel popülerlik kaynağı.
APPTWEAK_API_KEY=

# --- Opsiyonel: yalnız uygulama kaydı oluşturmak (fastlane produce) için ---
# Yalnız uygulama kaydını `fastlane produce` ile açmak için Apple ID e-postası. Normal akışta gerekmez.
FASTLANE_USER=
# Yalnız `produce` için. Uygulamaya özel parola değil, Apple ID parolası (2FA ister).
FASTLANE_PASSWORD=

# --- Opsiyonel: App Review demo hesabı ---
# App Review için demo hesap kullanıcı adı (giriş gerektiren uygulamalarda).
REVIEW_DEMO_USER=
# App Review demo hesabının parolası. Süresi dolmamalı.
REVIEW_DEMO_PASSWORD=
