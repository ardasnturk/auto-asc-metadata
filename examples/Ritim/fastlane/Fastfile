# Vitrin tarafından üretildi. `vitrin upload` bu lane'leri çağırır; elle de çalıştırılabilir.
# Değerler .env'den okunur ve asla loglanmaz.
default_platform(:ios)

platform :ios do
  private_lane :vitrin_api_key do
    if ENV["ASC_KEY_CONTENT_BASE64"].to_s.strip != ""
      app_store_connect_api_key(
        key_id: ENV.fetch("ASC_KEY_ID"),
        issuer_id: ENV.fetch("ASC_ISSUER_ID"),
        key_content: ENV.fetch("ASC_KEY_CONTENT_BASE64"),
        is_key_content_base64: true,
        duration: 1200,
        in_house: false
      )
    else
      app_store_connect_api_key(
        key_id: ENV.fetch("ASC_KEY_ID"),
        issuer_id: ENV.fetch("ASC_ISSUER_ID"),
        key_filepath: ENV.fetch("ASC_KEY_PATH"),
        duration: 1200,
        in_house: false
      )
    end
  end

  def vitrin_common
    {
      app_identifier: ENV.fetch("VITRIN_BUNDLE_ID"),
      platform: ENV.fetch("VITRIN_PLATFORM", "ios"),
      metadata_path: "fastlane/metadata",
      screenshots_path: "fastlane/screenshots",
      app_previews_path: "fastlane/app-previews",
      skip_binary_upload: true,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    }.tap do |opts|
      version = ENV["VITRIN_APP_VERSION"].to_s.strip
      opts[:app_version] = version unless version.empty?
      langs = ENV["VITRIN_LANGUAGES"].to_s.strip
      opts[:languages] = langs.split(",") unless langs.empty?
      # Demo hesabı dosyaya yazılmaz; yalnız .env'den okunur.
      # Bu hash verilince deliver review_information/ klasörünü okumaz; o yüzden ikisi burada birleştirilir.
      if ENV["REVIEW_DEMO_USER"].to_s.strip != ""
        dir = File.join(Dir.pwd, "..", "fastlane", "metadata", "review_information")
        dir = File.join(Dir.pwd, "metadata", "review_information") unless File.directory?(dir)
        read = ->(name) { f = File.join(dir, "#{name}.txt"); File.exist?(f) ? File.read(f).strip : nil }
        opts[:app_review_information] = {
          first_name: read.call("first_name"),
          last_name: read.call("last_name"),
          phone_number: read.call("phone_number"),
          email_address: read.call("email_address"),
          notes: read.call("notes"),
          demo_user: ENV["REVIEW_DEMO_USER"],
          demo_password: ENV["REVIEW_DEMO_PASSWORD"].to_s
        }.compact
      end
    end
  end

  desc "Metin metadata, ekran görüntüleri ve App Preview'ları yükler (incelemeye göndermez)"
  lane :vitrin_upload do
    api_key = vitrin_api_key
    deliver(vitrin_common.merge(
      api_key: api_key,
      overwrite_screenshots: true,
      overwrite_preview_videos: true,
      skip_screenshots: ENV["VITRIN_SKIP_SCREENSHOTS"] == "1",
      skip_metadata: ENV["VITRIN_SKIP_METADATA"] == "1"
    ))
  end

  desc "Yalnız metin metadata"
  lane :vitrin_upload_metadata do
    api_key = vitrin_api_key
    deliver(vitrin_common.merge(api_key: api_key, skip_screenshots: true))
  end

  desc "Yalnız doğrulama: deliver ile yükleme yapmadan kontrol"
  lane :vitrin_verify do
    api_key = vitrin_api_key
    deliver(vitrin_common.merge(api_key: api_key, verify_only: true, skip_screenshots: true))
  end

  desc "Düzenlenebilir App Store sürümü açmayı dener (ilk sürüm ASC'de elle açılmalı olabilir)"
  lane :vitrin_create_version do
    api_key = vitrin_api_key
    deliver(vitrin_common.merge(
      api_key: api_key,
      app_version: ENV.fetch("VITRIN_APP_VERSION"),
      skip_screenshots: true,
      skip_metadata: true,
      skip_app_version_update: false
    ))
  end

  desc "İncelemeye gönderir — yalnız `vitrin submit` açık onayla çağırır"
  lane :vitrin_submit do
    api_key = vitrin_api_key
    deliver(vitrin_common.merge(
      api_key: api_key,
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: true,
      submission_information: { add_id_info_uses_idfa: false }
    ))
  end
end
