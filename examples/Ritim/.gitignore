# >>> vitrin (managed block, edits inside are overwritten)
# secrets
.env
*.p8
secrets/
# Vitrin workspace: generated files stay local, the sources Claude writes are committable
/metadata/*
!/metadata/.vitrin-workspace
!/metadata/app_profile.json
!/metadata/listing/
!/metadata/art-direction.json
!/metadata/shots.json
!/metadata/video-plan.json
!/metadata/cpp-suggestions.json
!/metadata/experiments.json
!/metadata/screens/
!/metadata/designs/
!/metadata/photos/
!/metadata/rankings/
!/metadata/research/
/metadata/research/*
!/metadata/research/keywords/
# store outputs (retention.commit: true)
!/metadata/app-store/
!/metadata/google-play/
!/metadata/manifest.json
!/metadata/store/
!/metadata/creative/
!/metadata/mockups/
# older Vitrin versions
/.vitrin/
/fastlane/screenshots/
/fastlane/app-previews/
/fastlane/metadata/android/**/images/
/fastlane/report.xml
/fastlane/README.md
# <<< vitrin

# Ritim is Vitrin's example: what a /vitrin run produces is committed on purpose — the HTML screens and their
# renders, the design samples with the store preview, the store set (screenshots, App Previews, text), the
# creatives and the review gallery. Caches, downloads, run state and files that only hold this machine's paths
# stay local.
!/metadata/raw/
!/metadata/briefs/
!/metadata/report.html
!/metadata/design-samples/
/metadata/design-samples/**/*.html
!/metadata/design-samples/store-preview.html
/metadata/design-samples/samples.json
/metadata/research/icons.png
